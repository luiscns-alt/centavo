    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@eslint/js": "^9.39.4",
    "@pandacss/dev": "^2.0.0",
    "@pandacss/preset-base": "^2.0.0",
